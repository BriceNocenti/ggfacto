#: interpret.R:516
msgid ""
"sd/mean: coefficient of variation -- the standard deviation as a percentage "
"of the mean, comparable between variables measured in different units"
msgstr ""
"sd/mean : coefficient de variation -- l'écart-type en pourcentage de la "
"moyenne, comparable entre variables mesurées dans des unités différentes"

#: interpret.R:528
msgid "ctr: the level's contribution to the variance of the axis"
msgstr "ctr : la contribution de la modalité à la variance de l'axe"

#: interpret.R:529
msgid "contrib: the whole question's contribution to the axis"
msgstr "contrib : la contribution de la question entière à l'axe"

#: interpret.R:531
msgid "coord: coordinate on the axis"
msgstr "coord : coordonnée sur l'axe"

#: interpret.R:532
msgid "cos2: quality of representation"
msgstr "cos2 : qualité de représentation"

#: interpret.R:533
msgid ""
"spread: share of the group's contribution the gap between its two sides "
"accounts for"
msgstr ""
"spread : part de la contribution de la question qu'explique l'écart entre "
"ses deux côtés"

#: interpret.R:629 interpret.R:716
#, c-format
msgid "Axe %s: %s%% of variance"
msgstr "Axe %s : %s %% de variance"

#: interpret.R:630
#, c-format
msgid "Axe %s: %s%% of variance (mod. %s%%)"
msgstr "Axe %s : %s %% de variance (mod. %s %%)"

#: interpret.R:708
msgid "Rows"
msgstr "Lignes"

#: interpret.R:708
msgid "Columns"
msgstr "Colonnes"

#: interpret.R:767
msgid "Total"
msgstr "Total"

#: interpret.R:832
msgid ""
"contrib: its contribution to the variance of the axis; an axis sums to 100 %"
msgstr "contrib : sa contribution à la variance de l'axe ; un axe fait 100 %"

