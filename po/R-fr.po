#: interpret.R:483
msgid "contribution to the variance of the axis"
msgstr "contribution à la variance de l'axe"

#: interpret.R:484
msgid "a level"
msgstr "une modalité"

#: interpret.R:485
msgid "%1$s on the positive side, contributing"
msgstr "%1$s du côté positif, contribuant"

#: interpret.R:486
