#: interpret.R:503
msgid "quality of representation"
msgstr "qualité de représentation"

#: interpret.R:506
msgid "quality of representation, against the rule of 50 %"
msgstr "qualité de représentation, par rapport au seuil de 50 %"

#: interpret.R:507
msgid "a variable"
msgstr "une variable"

#: interpret.R:508
msgid "%1$s above, by"
msgstr "%1$s au-dessus, de"

